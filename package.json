    "demo:assistant-explorer": "node examples/purpose-demos/run-demo.mjs --profile modular-assistant --open",
    "demo:world-explorer": "node examples/purpose-demos/run-demo.mjs --profile digital-world --open",
    "demo:capabilities-explorer": "node examples/purpose-demos/run-demo.mjs --profile capability-directory --open",
    "check:repository": "node scripts/check-repository.mjs",
    "ui": "node bin/world-hub.mjs --open",
    "test:launcher": "node scripts/verify.mjs --suite launcher",

{
  "name": "world-hub",
  "version": "0.13.2",
  "license": "MIT",
  "author": "oooBCKooo",
  "repository": { "type": "git", "url": "git+https://github.com/oooBCKooo/world-hub.git" },
  "homepage": "https://github.com/oooBCKooo/world-hub#readme",
  "bugs": { "url": "https://github.com/oooBCKooo/world-hub/issues" },
  "keywords": ["mod", "bridge", "websocket", "messaging", "hub"],
  "bin": { "world-hub": "bin/world-hub.mjs" },
  "exports": {
    ".": "./sdk/javascript/bridge-kit.mjs",
    "./bridge": "./sdk/javascript/bridge-kit.mjs",
    "./blob": "./sdk/javascript/blob-client.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "README.en.md",
    "bin/world-hub.mjs",
    "src/**/*.mjs", "src/**/*.html", "src/**/*.css",
    "sdk/javascript/bridge-kit.mjs", "sdk/javascript/blob-client.mjs", "sdk/javascript/README.md",
    "sdk/python/hub_bridge.py", "sdk/python/requirements.txt", "sdk/python/README.md",
    "sdk/powershell/HubBridge.psm1", "sdk/powershell/HubBridge.cs", "sdk/powershell/README.md",
    "config/hub.json", "scripts/launcher.mjs", "scripts/launcher-support.mjs",
    "docs/**/*.md", "docs/images/hub-topology.jpg", "docs/images/hub-workbench.jpg",
    "docs/images/demo-event-desk.jpg", "docs/images/demo-modular-assistant.jpg", "docs/images/demo-digital-world.jpg",
    "docs/images/hub-topology-en.jpg", "docs/images/hub-workbench-en.jpg",
    "docs/images/demo-event-desk-en.jpg", "docs/images/demo-modular-assistant-en.jpg", "docs/images/demo-digital-world-en.jpg"
  ],
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org/" },
  "type": "module",
  "description": "Communications crossroads for external programs connected through bidirectional mod bridges.",
  "engines": {
    "node": ">=22.4.0"
  },
  "scripts": {
    "start": "node scripts/launcher.mjs",
    "check": "node scripts/launcher.mjs --check",
    "hub": "node src/hub/hub-server.mjs --config config/hub.json",
    "token": "node src/hub/hub-server.mjs --print-token",
    "test": "node scripts/verify.mjs --suite node",
    "verify": "node scripts/verify.mjs --suite node",
    "test:dsh": "node scripts/verify.mjs --suite dsh",
    "test:cross-language": "node scripts/verify.mjs --suite cross-language",
    "test:distribution": "node --test --test-timeout=60000 scripts/release/distribution.test.mjs",
    "test:npm": "node --test --test-timeout=120000 tests/integration/npm/*.test.mjs",
    "test:demos": "node scripts/verify.mjs --suite demos",
    "test:recovery": "node scripts/test-recovery.mjs",
    "build": "node scripts/release/build-package.mjs",
    "build:demos": "node scripts/release/build-demo-packages.mjs",
    "verify:package": "node scripts/release/verify-package.mjs",
    "demo:management": "node examples/management/run-management-demo.mjs",
    "demo:events": "node examples/event-panel/run-demo.mjs",
    "demo:directed": "node examples/directed-transfer/run-phase4.mjs",
    "demo:workflow": "node examples/workflows/run-flows.mjs --demo",
    "demo:context": "node examples/distributed-context/run-phase2.mjs --fixture",
    "demo:three": "node examples/three-programs/run-three.mjs",
    "demo:events-explorer": "node examples/purpose-demos/run-demo.mjs --profile event-desk --open",
    "demo:assistant-explorer": "node examples/purpose-demos/run-demo.mjs --profile modular-assistant --open",
    "demo:world-explorer": "node examples/purpose-demos/run-demo.mjs --profile digital-world --open",
    "check:repository": "node scripts/check-repository.mjs"
  }
}

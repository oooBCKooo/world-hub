{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/oooBCKooo/world-hub/docs/ecosystem/data.schema.json",
  "title": "Opaque module business data resource, v1",
  "$comment": "Only data.json and files under each exact data/<logical instance ID>/ subtree may be included. The runtime enforces a 1 MiB document bound, JSON depth, unique logical IDs, path equality, no case or prefix collisions, ordinary files and bounds of 4096 files, 8 MiB per file and 64 MiB total. Business data is opaque and never executed. Backup artifacts stay local and cannot be publicly published.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "id",
    "version",
    "title",
    "license",
    "platforms",
    "provides",
    "requires",
    "scope",
    "purpose",
    "instances"
  ],
  "properties": {
    "format": {
      "const": "world-hub.module-data/v1"
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "version": {
      "$ref": "#/$defs/version"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000\\r\\n]*\\S[^\\u0000\\r\\n]*$"
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000\\r\\n]*\\S[^\\u0000\\r\\n]*$"
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+-[a-z0-9]+$"
      }
    },
    "provides": {
      "$ref": "#/$defs/contracts"
    },
    "requires": {
      "$ref": "#/$defs/contracts"
    },
    "scope": {
      "enum": [
        "global",
        "local"
      ]
    },
    "purpose": {
      "enum": [
        "dataset",
        "backup"
      ]
    },
    "instances": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "module",
          "path",
          "dataFormat"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "module": {
            "$ref": "#/$defs/module"
          },
          "path": {
            "type": "string",
            "maxLength": 69,
            "pattern": "^data/[a-z0-9][a-z0-9._-]{0,63}$"
          },
          "dataFormat": {
            "$ref": "#/$defs/contract"
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "version": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z]+(?:[.-][0-9A-Za-z]+)*)?$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\u0000]+$"
        },
        "version": {
          "$ref": "#/$defs/version"
        }
      }
    },
    "contracts": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/contract"
      }
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "digest"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "digest": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}

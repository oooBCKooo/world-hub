{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/oooBCKooo/world-hub/docs/ecosystem/module.schema.json",
  "title": "Optional external program deployment module, v1",
  "$comment": "This deployment document is not a Hub handshake or bridge requirement. Reference Runtime validation also checks paths, duplicates and package semantics; that implementation is authoritative for its v1 profile.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "id",
    "version",
    "license",
    "platforms",
    "runtime",
    "bridges",
    "provides",
    "requires",
    "permissions"
  ],
  "properties": {
    "format": {
      "const": "world-hub.module/v1"
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "version": {
      "$ref": "#/$defs/version"
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000]+$"
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+-[a-z0-9]+$"
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "entry"
      ],
      "properties": {
        "kind": {
          "enum": [
            "node",
            "python"
          ]
        },
        "entry": {
          "$ref": "#/$defs/path"
        }
      }
    },
    "bridges": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "provides": {
      "$ref": "#/$defs/contracts"
    },
    "requires": {
      "$ref": "#/$defs/contracts"
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "filesystem",
        "network",
        "processes"
      ],
      "properties": {
        "filesystem": {
          "const": "instance-state"
        },
        "network": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "hub-loopback",
              "loopback-listen"
            ]
          }
        },
        "processes": {
          "const": "none"
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "version": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z]+(?:[.-][0-9A-Za-z]+)*)?$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))[^\\\\:\\u0000]+$"
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\u0000]+$"
        },
        "version": {
          "$ref": "#/$defs/version"
        }
      }
    },
    "contracts": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/contract"
      }
    }
  }
}

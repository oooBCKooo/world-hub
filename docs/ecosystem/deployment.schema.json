{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Optional author-selected deployment defaults",
  "type":"object","additionalProperties":false,
  "required":["format","title","description","topics","bridges","settings"],
  "properties":{
    "format":{"const":"world-hub.deployment/v1"},
    "title":{"$ref":"#/$defs/localized"},"description":{"$ref":"#/$defs/localized"},
    "topics":{"type":"object","minProperties":1,"maxProperties":64,"propertyNames":{"pattern":"^[a-z0-9][a-z0-9._-]{0,63}$"},"additionalProperties":{"type":"string","minLength":1,"maxLength":512}},
    "bridges":{"type":"object","minProperties":1,"maxProperties":8,"additionalProperties":{"type":"object","additionalProperties":false,"required":["publish","subscribe"],"properties":{"publish":{"$ref":"#/$defs/aliases"},"subscribe":{"$ref":"#/$defs/aliases"}}}},
    "settings":{"type":"array","maxItems":64,"items":{"type":"object","additionalProperties":false,"required":["key","label","type","default"],"properties":{"key":{"type":"string","pattern":"^[a-z0-9][a-z0-9._-]{0,63}$"},"label":{"$ref":"#/$defs/localized"},"type":{"enum":["string","number","boolean"]},"default":{"type":["string","number","boolean"]},"min":{"type":"number"},"max":{"type":"number"}}}},
    "executionDefaults":{"$ref":"#/$defs/executionDefaults"},
    "connections":{"type":"array","maxItems":32,"items":{"type":"object","additionalProperties":false,"required":["id","provider","contracts","topics"],"properties":{"id":{"$ref":"#/$defs/id"},"provider":{"type":"object","additionalProperties":false,"required":["moduleId","version"],"properties":{"moduleId":{"$ref":"#/$defs/id"},"version":{"$ref":"#/$defs/version"}}},"contracts":{"type":"array","maxItems":32,"uniqueItems":true,"items":{"type":"object","additionalProperties":false,"required":["id","version"],"properties":{"id":{"type":"string","minLength":1,"maxLength":128},"version":{"$ref":"#/$defs/version"}}}},"topics":{"type":"object","maxProperties":64,"propertyNames":{"$ref":"#/$defs/id"},"additionalProperties":{"$ref":"#/$defs/id"}}},"anyOf":[{"properties":{"contracts":{"minItems":1}}},{"properties":{"topics":{"minProperties":1}}}]}},
    "dependencies":{"type":"object","additionalProperties":false,"required":["kind","manifest","lock","recipes"],"properties":{"kind":{"const":"npm-lock"},"manifest":{"const":"package.json"},"lock":{"const":"package-lock.json"},"recipes":{"type":"array","maxItems":1,"items":{"const":"electron"}}}}
  },
  "$defs":{
    "executionDefaults":{"type":"object","additionalProperties":false,"required":["mode"],"properties":{"mode":{"enum":["resident","on-demand"]},"idleTimeoutMs":{"type":"integer","minimum":1000,"maximum":86400000,"default":60000}},"description":"Initial lifecycle defaults for a new local instance. Caller authorization is selected locally and cannot be declared here."},
    "id":{"type":"string","pattern":"^[a-z0-9][a-z0-9._-]{0,63}$"},
    "version":{"type":"string","maxLength":128,"pattern":"^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z]+(?:[.-][0-9A-Za-z]+)*)?$"},
    "localized":{"type":"object","minProperties":1,"additionalProperties":false,"properties":{"zh":{"type":"string","minLength":1,"maxLength":2048},"en":{"type":"string","minLength":1,"maxLength":2048}}},
    "aliases":{"type":"array","maxItems":64,"uniqueItems":true,"items":{"type":"string","pattern":"^[a-z0-9][a-z0-9._-]{0,63}$"}}
  },
  "$comment":"Runtime deployment.mjs additionally validates concrete topics, exact bridge slots, matching field default types, duplicate keys, sensitive-setting keys, locked official dependency origins and integrity, unique connection IDs, declared local aliases, disjoint default topic mappings, and required exact connection contracts."
}

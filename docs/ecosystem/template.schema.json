{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/oooBCKooo/world-hub/docs/ecosystem/template.schema.json",
  "title": "Shareable locked composition Template, v1",
  "$comment": "A complete Template has this template.json plus base/pack.json, base/pack.lock and every exact locked module file. Static reference validation also checks content hashes, unique names/targets, exact contracts, scalar target existence/type, default materialization and forbidden runtime/path/credential keys. Templates never execute code or interpolate strings.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "id", "version", "title", "license", "base", "parameters"],
  "properties": {
    "format": { "const": "world-hub.template/v1" },
    "id": { "$ref": "#/$defs/id" },
    "version": { "$ref": "#/$defs/version" },
    "title": { "$ref": "#/$defs/title" },
    "license": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^\\u0000]+$" },
    "base": { "const": "base" },
    "parameters": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/parameter" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
    "version": { "type": "string", "maxLength": 128, "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z]+(?:[.-][0-9A-Za-z]+)*)?$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\u0000]+$" },
    "scalar": { "type": ["string", "number", "boolean"] },
    "constraints": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "minLength": { "type": "integer", "minimum": 0, "maximum": 4096 },
        "maxLength": { "type": "integer", "minimum": 0, "maximum": 4096 },
        "minimum": { "type": "number" },
        "maximum": { "type": "number" },
        "enum": { "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "$ref": "#/$defs/scalar" } }
      }
    },
    "target": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["kind", "key"], "properties": { "kind": { "const": "topic" }, "key": { "$ref": "#/$defs/id" } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "component", "path"], "properties": {
          "kind": { "const": "setting" }, "component": { "$ref": "#/$defs/id" },
          "path": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$", "not": { "enum": ["__proto__", "constructor", "prototype"] } } }
        } }
      ]
    },
    "parameter": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "title", "type", "default", "constraints", "targets"],
      "properties": {
        "name": { "allOf": [{ "$ref": "#/$defs/id" }, { "not": { "enum": ["__proto__", "constructor", "prototype"] } }] },
        "title": { "$ref": "#/$defs/title" }, "type": { "enum": ["string", "integer", "number", "boolean"] },
        "default": { "$ref": "#/$defs/scalar" }, "constraints": { "$ref": "#/$defs/constraints" },
        "targets": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/target" } }
      },
      "allOf": [
        { "if": { "properties": { "type": { "const": "string" } } }, "then": { "properties": { "default": { "type": "string", "maxLength": 4096, "pattern": "^[^\\u0000]*$" }, "constraints": { "not": { "anyOf": [{ "required": ["minimum"] }, { "required": ["maximum"] }] } } } } },
        {
          "if": { "properties": { "type": { "const": "integer" } } },
          "then": {
            "properties": {
              "default": { "type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991 },
              "constraints": {
                "properties": {
                  "minimum": { "type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991 },
                  "maximum": { "type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991 }
                },
                "not": { "anyOf": [{ "required": ["minLength"] }, { "required": ["maxLength"] }] }
              },
              "targets": { "items": { "properties": { "kind": { "const": "setting" } } } }
            }
          }
        },
        { "if": { "properties": { "type": { "const": "number" } } }, "then": { "properties": { "default": { "type": "number" }, "constraints": { "not": { "anyOf": [{ "required": ["minLength"] }, { "required": ["maxLength"] }] } }, "targets": { "items": { "properties": { "kind": { "const": "setting" } } } } } } },
        { "if": { "properties": { "type": { "const": "boolean" } } }, "then": { "properties": { "default": { "type": "boolean" }, "constraints": { "not": { "anyOf": [{ "required": ["minLength"] }, { "required": ["maxLength"] }, { "required": ["minimum"] }, { "required": ["maximum"] }] } }, "targets": { "items": { "properties": { "kind": { "const": "setting" } } } } } } }
      ]
    }
  }
}
